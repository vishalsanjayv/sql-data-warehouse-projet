-- Checking Primary key for duplicates and Null Values --
SELECT
cst_id,
COUNT(*) AS Duplicates
FROM bronze.crmCustInfo
GROUP BY cst_id
HAVING COUNT(*) > 1 or cst_id is NULL;

-- Taking an element to try and find the duplication pattern -- 
SELECT
*
FROM bronze.crmCustInfo
WHERE cst_id = 29466;
-- It is evident that the duplicates are a result of partial updates throughout the years--

-- Keeping only the latest records using a window function --

SELECT *
FROM (
SELECT
*,
ROW_NUMBER() OVER(PARTITION BY cst_id ORDER BY cst_create_date DESC) as Dflag
FROM bronze.crmCustInfo
WHERE cst_id IS NOT NULL
)t 
WHERE Dflag = 1;

-- Check for unwanted spaces in columns -- 

SELECT
cst_lastname 
FROM bronze.crmcustinfo
WHERE cst_firstname != TRIM(cst_lastname);

-- Unabbreviating the columns and handling nulls to better suit conventions before inserting the tables into silver layer --

INSERT INTO silver.crmCustInfo (
	cst_id,
	cst_key,
	cst_firstname,
	cst_lastname,
	cst_marital_status,
	cst_gndr,
	cst_create_date)
	SELECT
	cst_id,
	cst_key,
	TRIM(cst_firstname) as cst_firstname,
	TRIM(cst_lastname) as cst_lastname,
	CASE WHEN UPPER(cst_marital_status) = 'M' THEN 'Married'
		WHEN UPPER(cst_marital_status) = 'S' THEN 'Single'
		ELSE 'n/a'
	END as cst_marital_status,
	CASE WHEN UPPER(cst_gndr) = 'M' THEN 'Male'
		WHEN UPPER(cst_gndr) = 'F' THEN 'Female'
		ELSE 'n/a'
	END as cst_cst_gndr,
	cst_create_date
	FROM (
	SELECT
	*,
	ROW_NUMBER() OVER(PARTITION BY cst_id ORDER BY cst_create_date DESC) as Dflag
	FROM bronze.crmCustInfo
	WHERE cst_id IS NOT NULL
	)t 
	WHERE Dflag = 1;
