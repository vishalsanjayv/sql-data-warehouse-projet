 -- Checking for unwanted spaces --
SELECT 
sls_ord_num,
sls_prd_key
FROM bronze.crmSalesDetails 
WHERE sls_ord_num != TRIM(sls_ord_num) OR sls_prd_key != TRIM(sls_prd_key);

-- Checking for Invalid Date Values --

SELECT
sls_order_dt
FROM bronze.crmSalesDetails
WHERE LEN(sls_due_dt) > 8 
OR LEN(sls_due_dt) < 8
OR sls_due_dt <= 0 -- For negative values --
OR sls_due_dt < 20000101 -- Starting limit --
OR sls_due_dt > 20270101 -- ENding limit --

-- Verifying sales, quantity and price columns for errors in calculations --

SELECT 
sls_sales,
sls_quantity,
CASE WHEN sls_sales IS NULL OR sls_sales <=0 OR sls_sales != sls_quantity * ABS(sls_price)
	THEN sls_quantity * ABS(sls_price)
	ELSE sls_sales
END as sls_sales,
sls_price as Old_price,
CASE WHEN sls_price IS NULL OR sls_price <=0
	THEN sls_sales / NULLIF(sls_quantity, 0)
	ELSE sls_price
END AS sls_price
FROM bronze.crmsalesdetails
WHERE sls_sales != sls_quantity * sls_price OR sls_sales IS NULL OR sls_sales <=0
OR sls_quantity IS NULL OR sls_quantity <=0 OR sls_price IS NULL OR sls_price <=0

-- Correction before insertion --

INSERT INTO silver.crmSalesDetails (
sls_ord_num,
sls_prd_key,
sls_cust_id,
sls_order_dt,
sls_ship_dt,
sls_due_dt,
sls_sales,
sls_quantity,
sls_price)
SELECT
sls_ord_num,
sls_prd_key,
sls_cust_id,
CASE WHEN sls_order_dt = 0 OR LEN(sls_order_dt) != 8 THEN NULL
	ELSE CAST(CAST(sls_order_dt AS VARCHAR) AS DATE)
END AS sls_order_dt,
CASE WHEN sls_ship_dt = 0 OR LEN(sls_ship_dt) != 8 THEN NULL
	ELSE CAST(CAST(sls_ship_dt AS VARCHAR) AS DATE)
END AS sls_ship_dt,
CASE WHEN sls_due_dt = 0 OR LEN(sls_due_dt) != 8 THEN NULL
	ELSE CAST(CAST(sls_due_dt AS VARCHAR) AS DATE)
END AS sls_due_dt,
CASE WHEN sls_sales IS NULL OR sls_sales <=0 OR sls_sales != sls_quantity * ABS(sls_price)
	THEN sls_quantity * ABS(sls_price)
	ELSE sls_sales
END as sls_sales,
sls_quantity,
CASE WHEN sls_price IS NULL OR sls_price <=0
	THEN sls_sales / NULLIF(sls_quantity, 0)
	ELSE sls_price
END AS sls_price
FROM bronze.crmSalesDetails;

-- Now doing the same tests for tables in silver layer --

SELECT 
sls_ord_num,
sls_prd_key
FROM silver.crmSalesDetails 
WHERE sls_ord_num != TRIM(sls_ord_num) OR sls_prd_key != TRIM(sls_prd_key);

-- Checking for Invalid Date Values --
-- Result would be an error as the data type has been changed from Int to Date --

SELECT
sls_order_dt
FROM silver.crmSalesDetails
WHERE LEN(sls_due_dt) > 8 
OR LEN(sls_due_dt) < 8
OR sls_due_dt <= 0 -- For negative values --
OR sls_due_dt < 20000101 -- Starting limit --
OR sls_due_dt > 20270101 -- ENding limit --

-- Checking for sales figure discrepancies --

SELECT
sls_sales,
sls_quantity,
sls_price
FROM silver.crmSalesDetails
WHERE sls_sales != sls_quantity * sls_price 
OR sls_sales IS NULL OR sls_quantity IS NULL OR sls_price IS NULL
OR sls_sales <= 0 OR sls_quantity <= 0 OR sls_price <= 0
ORDER BY sls_sales, sls_quantity, sls_price;
