-- Checking the CrmPrdInfo Table for data constistency --
-- Duplicates and null verification --

SELECT 
prd_id,
COUNT(*) AS Duplicates
FROM bronze.crmPrdInfo
GROUP BY prd_id
HAVING COUNT(*) > 1 OR prd_id IS Null;

-- Unwanted Spaces Check --

SELECT 
prd_key,
prd_nm
FROM bronze.crmPrdInfo
WHERE TRIM(prd_key) != prd_key or TRIM(prd_nm) != prd_nm;

-- Checking for negative values in cost --
SELECT
prd_cost
FROM bronze.crmPrdInfo
WHERE prd_cost > 0 OR prd_cost IS NULL;

-- Checking Date Orders --
SELECT *
FROM bronze.crmPrdinfo
WHERE prd_end_dt < prd_start_dt;
-- Manupulating the existing columns before inserting into silver layer --
INSERT INTO silver.crmPrdInfo (
	prd_id,
	cat_id,
	prd_key,
	prd_nm,
	prd_cost,
	prd_line,
	prd_start_dt,
	prd_end_dt
)
SELECT
prd_id,
REPLACE(SUBSTRING(prd_key, 1,5), '-','_') AS cat_id, -- Derived Column --
SUBSTRING(prd_key,7,len(prd_key)) AS prd_key, -- Derived Column --
prd_nm,
COALESCE(prd_cost,0) as prd_cost,
CASE UPPER(prd_line)
	WHEN 'S' THEN 'Others'
	WHEN 'M' THEN 'Mountain'
	WHEN 'R' THEN 'Road'
	WHEN 'T' THEN 'Touring'
	ELSE 'n/a' -- For null Values --
END AS prd_line,
CAST(prd_start_dt AS DATE) AS prd_start_dt,
DATEADD(DAY, -1,CAST(LEAD(prd_start_dt) OVER(PARTITION BY prd_key ORDER BY prd_start_dt) AS DATE))AS prd_end_dt
FROM bronze.crmPrdInfo;

-- Verifying the working of the table --

SELECT * 
FROM silver.crmPrdInfo;
